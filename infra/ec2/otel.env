# OpenTelemetry Java 에이전트 설정. 비밀값이 없어 Parameter Store 가 아니라 저장소에 둔다.
# moyeota.service 가 EnvironmentFile 로 읽는다. 바꾼 뒤에는 bootstrap.sh 재실행 + 앱 재시작이 필요하다.
OTEL_SERVICE_NAME=moyeota-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
# 같은 호스트의 Alloy 로 보낸다. 앱은 Tempo 의 주소도 생사도 모른다 - 걸러서 넘기는 일은 Alloy 가 한다
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
# 지표는 Prometheus 가 /prometheus 를 긁고, 로그는 Alloy 가 journald 에서 읽는다 - 에이전트로는 추적만 낸다
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# 전부 내보낸다. 느린 요청·에러를 골라 남기는 건 요청이 끝난 뒤에야 가능해서 Alloy(tail sampling)가 한다
OTEL_TRACES_SAMPLER=always_on
